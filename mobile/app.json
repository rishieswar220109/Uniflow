{
  "expo": {
    "name": "AI Payment Guardian",
    "slug": "ai-payment-guardian",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "aipaymentguardian",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "android": {
      "package": "com.aipaymentguardian.app",
      "usesCleartextTraffic": true,
      "predictiveBackGestureEnabled": false
    },
    "ios": {
      "bundleIdentifier": "com.aipaymentguardian.app",
      "supportsTablet": true,
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
