# ---------------------------------------------------------------------------
# UniFlow - development environment template
# Copy this file to `.env` and replace every placeholder value.
# Never commit the real `.env` file.
# ---------------------------------------------------------------------------

# Application
ENVIRONMENT=development
DEBUG=false
APP_VERSION=1.0.0

# PostgreSQL (used by docker-compose)
POSTGRES_USER=guardian
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=guardian

# Backend database connection when running locally (non-Docker).
# Inside Docker Compose the host is `db` instead of `localhost`.
DATABASE_URL=postgresql+psycopg://guardian:replace-with-a-long-random-password@localhost:5432/guardian

# Authentication
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=replace-with-at-least-32-random-characters
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAMESITE=lax

# Authentication rate limiting (per client IP, per backend process).
# Disable only for controlled testing; production should also limit at the edge.
AUTH_RATE_LIMIT_ENABLED=true
AUTH_RATE_LIMIT_ATTEMPTS=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=300

# Comma-separated origins allowed to call the API from a browser.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8081

# Financial data providers (Phase 2).
# Only the bundled `mock` provider exists. A live adapter must be registered in
# backend/app/providers/bank/registry.py before its slug can be used here.
BANK_PROVIDER=mock
# First-sync transaction lookback, in days (1-3650).
BANK_SYNC_LOOKBACK_DAYS=120

# Web frontend (Vite). Leave empty to use the Vite dev proxy. This root .env
# is not read by Vite; set the variable in frontend/web/.env only if needed.
VITE_API_BASE_URL=

# Mobile frontend (Expo). Use your computer's LAN IP for a physical device,
# e.g. http://192.168.1.20:8000/api/v1
EXPO_PUBLIC_API_URL=http://localhost:8000/api/v1

# Test database. Must end in `_test`; never point this at real data.
TEST_DATABASE_URL=postgresql+psycopg://guardian:replace-with-a-long-random-password@localhost:5432/guardian_test
